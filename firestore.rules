rules_version = '2';

// Opatruj — bezpečnostní pravidla
//
// Psaná od prvního commitu, ne dodatečně. Vychází z stejné logiky jako
// appka Střídavě: appka nikdy nevěří sama sobě, věří jen tomu, co si
// server (tato pravidla + Cloud Functions) sám ověří.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Pomocné funkce -----------------------------------------------
    // Proč funkce, ne opakovaný zápis: stejná podmínka se používá na
    // desítkách míst níž. Jedna oprava logiky na jednom místě, ne na
    // desítkách míst zvlášť s rizikem, že se na jedno zapomene.

    function jePrihlasen() {
      return request.auth != null;
    }

    function jeClenemRodiny(rodinaId) {
      return jePrihlasen() &&
        exists(/databases/$(database)/documents/families/$(rodinaId)/members/$(request.auth.uid));
    }

    function roleVRodine(rodinaId) {
      return get(/databases/$(database)/documents/families/$(rodinaId)/members/$(request.auth.uid)).data.role;
    }

    function maPlnyPristup(rodinaId) {
      // Proč: "host" (vzdálenější příbuzný, občasná výpomoc) vidí úkoly
      // a kontakty, ale ne zdravotní záznamy a dokumenty — nemá roli
      // v citlivé části péče, jen v koordinaci běžného dne.
      return jeClenemRodiny(rodinaId) && roleVRodine(rodinaId) in ['pecovatel', 'clen'];
    }

    function jePecovatel(rodinaId) {
      // Proč: správu členů (pozvat, odebrat) smí dělat jen hlavní
      // pečovatel, ne kdokoli s plným přístupem k datům.
      return jeClenemRodiny(rodinaId) && roleVRodine(rodinaId) == 'pecovatel';
    }

    // --- users/{uid} -----------------------------------------------------
    // Vlastní profil. Nic o rodině tu není — to je záměr, viz datový model.

    match /users/{uid} {
      allow read: if jePrihlasen() && request.auth.uid == uid;
      // Proč jen jmeno a email: pole mojeRodiny určuje, do jakých rodin
      // appka uživatele pustí, takže ho píše výhradně server (zalozitRodinu,
      // prijmoutPozvanku). Klient si ho nesmí upravit.
      allow create: if jePrihlasen() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['jmeno', 'email']);
      allow update: if jePrihlasen() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jmeno', 'email']);
      allow delete: if false;
    }

    // --- families/{rodinaId} ---------------------------------------------

    match /families/{rodinaId} {
      allow read: if jeClenemRodiny(rodinaId);
      // Proč create false: rodinu a prvního člena (pecovatel) zakládá
      // callable funkce zalozitRodinu. Klientský zápis rodiny by šel
      // dokončit jen zápisem do members, který je zakázaný.
      allow create: if false;
      // Proč jen nazev: zakladatelUid a ostatní pole mění jen server.
      allow update: if jePecovatel(rodinaId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nazev']);
      // Proč se rodina nemaže: historie péče má hodnotu i po jejím konci
      // (třeba pro budoucí přiznání dávky). Archivace, ne mazání.
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if jeClenemRodiny(rodinaId);
        // Proč nikdy write z appky: kdyby klient směl zapisovat členství,
        // kdokoli se znalostí rodinaId by si mohl přidat sám sebe.
        // Jediná cesta dovnitř je Cloud Function prijmoutPozvanku (Blok 2).
        allow write: if false;
      }

      match /carePersons/{personId} {
        // Proč čtou i host: biografie (jméno, zvyky, co uklidní) je součástí
        // dokumentu carePersons a i příležitostný pečovatel ji musí vidět,
        // aby uměl s člověkem mluvit. Psát ji smí jen ten, kdo má plný přístup.
        allow read: if jeClenemRodiny(rodinaId);
        allow write: if maPlnyPristup(rodinaId);

        match /health/{zaznamId} {
          // Proč přísnější než rodičovská data u carePersons: zdravotní
          // údaje jsou zvláštní kategorie osobních údajů (GDPR čl. 9).
          // I host, co jinak vidí většinu rodinných dat, sem nesmí.
          allow read, write: if maPlnyPristup(rodinaId);
        }

        match /krizovyPlan/{planId} {
          // Proč čte i host, na rozdíl od health: v krizové situaci (člověk
          // se ztratil, odmítá jíst) může být doma zrovna ten, kdo má
          // omezenou roli, a nesmí mu chybět přístup k postupu, co dělat.
          // Píše ho jen ten, kdo situaci dlouhodobě zná — maPlnyPristup.
          allow read: if jeClenemRodiny(rodinaId);
          allow write: if maPlnyPristup(rodinaId);
        }
      }

      match /tasks/{taskId} {
        allow read, write: if jeClenemRodiny(rodinaId);
      }

      match /notes/{noteId} {
        allow read: if maPlnyPristup(rodinaId);
        // Proč výčet polí: aiKategorie doplňuje Cloud Function s admin
        // právy. Kdyby ho směl zapsat klient, šlo by falšovat podklady pro
        // sociální šetření. Autor se bere z přihlášení, ne z toho, co klient
        // pošle, a čas určuje server.
        allow create: if maPlnyPristup(rodinaId) &&
          request.resource.data.keys().hasOnly(['osobaId', 'text', 'autorUid', 'vytvoreno']) &&
          request.resource.data.keys().hasAll(['osobaId', 'text', 'autorUid', 'vytvoreno']) &&
          request.resource.data.autorUid == request.auth.uid &&
          request.resource.data.vytvoreno == request.time;
        // Proč dvě cesty: text smí měnit jen autor. Ruční opravu hodnocení
        // (rucniHodnoceni) smí zapsat každý s plným přístupem, protože AI se
        // může mýlit a rodina ji opravuje společně. AI pole (aiKategorie,
        // aiHodnoceni) zůstávají jen serveru, oprava jde do vlastního pole
        // a přebíjí je při výpočtu. Autora ani čas změnit nejde.
        allow update: if maPlnyPristup(rodinaId) && (
          (resource.data.autorUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rucniHodnoceni']) &&
            request.resource.data.rucniHodnoceni is map &&
            request.resource.data.rucniHodnoceni.keys().hasOnly(['mobilita', 'orientace', 'komunikace', 'stravovani', 'oblekani', 'hygiena', 'vylucovani', 'pece_o_zdravi', 'osobni_aktivity', 'domacnost']) &&
            request.resource.data.rucniHodnoceni.values().hasOnly(['zvlada', 's_pomoci', 'nezvlada', 'nelze_urcit']))
        );
        allow delete: if jePecovatel(rodinaId) ||
          (maPlnyPristup(rodinaId) && resource.data.autorUid == request.auth.uid);
      }

      match /documents/{documentId} {
        allow read, write: if maPlnyPristup(rodinaId);
      }

      match /contacts/{contactId} {
        allow read, write: if jeClenemRodiny(rodinaId);
      }

      match /invites/{inviteId} {
        allow read: if jePecovatel(rodinaId);
        // Proč create false: pozvánku vytváří funkce vytvoritPozvanku. Datum
        // platnosti a role se tak nedají podvrhnout z klienta.
        allow create: if false;
        // Proč update/delete false: přijetí pozvánky (tj. změna jejího
        // stavu) dělá výhradně Cloud Function, nikdy klient přímo.
        allow update, delete: if false;
      }

      match /exports/{exportId} {
        // Proč jen read: export je jednorázový snímek, který generuje
        // a zapisuje výhradně Cloud Function. Appka jen čte hotový
        // výsledek a odkaz na PDF v Cloud Storage.
        allow read: if maPlnyPristup(rodinaId);
        allow write: if false;
      }

      match /auditLog/{entryId} {
        allow read: if jePecovatel(rodinaId);
        // Proč jen server: log ztrácí smysl, pokud by si ho mohl klient
        // sám upravit. Píšou ho jen Cloud Functions.
        allow write: if false;
      }
    }
  }
}
